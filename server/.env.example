DB_NAME=cu_orbit
DB_USER=root
DB_PASS=change-me
DB_HOST=localhost
PORT=3000

# --- Sign-in ---
# Google sign-in (POST /api/auth/google): the app hands us a Google-issued ID
# token and we verify it against Google's public keys — no client secret
# needed for this. Both client IDs are valid audiences; either can sign in.
# From Google Cloud Console > APIs & Services > Credentials.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Email OTP sign-in (POST /api/auth/otp/*) sends a 6-digit code via SMTP.
# Gmail: SMTP_USER/SMTP_PASS is an address + App Password (not the account
# password) — console.cloud.google.com won't help here, use
# myaccount.google.com/apppasswords on the sending account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Signs CU Orbit's own session tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORBIT_JWT_SECRET=

# Session lifetime (zeit/ms format).
ORBIT_SESSION_TTL=7d

# Passwordless phone login — returns a user for any phone number, with no
# credential of any kind. Leave unset. Enable only for local Android work,
# and never on an internet-facing deployment.
# ALLOW_LEGACY_AUTH=true

# --- Release publishing ---
# Machine credential for POST /api/system/register-release, called by the Gradle
# publish task. Must match RELEASE_TOKEN in the build environment. Without it
# the endpoint returns 503 and refuses to register anything.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RELEASE_TOKEN=

# --- Schema management ---
#   safe  (default) create missing tables, never modify existing ones
#   alter           reconcile live tables with the models on every boot — dev only
#   off             touch nothing; schema comes solely from migrations/
# Column changes belong in migrations/, not in a boot-time ALTER.
DB_SYNC=safe
